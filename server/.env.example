PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sportio_hub
JWT_SECRET=replace_this_with_a_long_random_secret
CLIENT_ORIGIN=http://localhost:5173

# SMTP settings for sending real email OTPs.
# For Gmail, use an App Password (not your normal account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM="Sportio Hub <your-email@gmail.com>"

# Optional: only enable in local development to return OTP in API response.
DEV_SHOW_OTP=true
